# Dependencies
node_modules/
.pnpm-store/

# Build output
scripts/dist/
*.tsbuildinfo

# Downloaded sample/test apps (fetched via scripts/src/apps/fetch-sample-apps.ts, never committed)
apps/android/build/
apps/ios/build/
*.apk
*.ipa
*.app/
*.zip

# Maestro + test execution artifacts
test-output/
# Maestro's own CLI hardcodes this path segment for its default debug-output
# directory (confirmed from real captured runs) - unrelated to, and not to be
# confused with, our own source folder .maestro/scenarios/.
.maestro/tests/
.maestro/.cache/
# takeScreenshot writes relative to CWD - stray captures from local/manual
# `maestro test` runs land here if run from inside .maestro/.
.maestro/*.png

# Environment secrets (only .env.example is committed)
config/.env
!config/.env.example

# Editor / OS
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*

# Claude Code local session/config data (personal machine only, never shared)
.claude/

# Coverage
coverage/
