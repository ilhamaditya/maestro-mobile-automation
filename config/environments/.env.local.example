# Copy this file to `.env.local` (gitignored) to customize local runs.
# See config/README.md and docs/EnvironmentGuide.md for how this is loaded.

ENVIRONMENT=local

# Placeholder app identifiers (Phase 1). Update these when a real target
# application replaces the Wikipedia sample - see docs/GettingStarted.md.
APP_ID_ANDROID=org.wikipedia
APP_ID_IOS=org.wikimedia.wikipedia

# Deterministic search query used by the Search vertical slice. Kept out of
# the flow YAML itself so it can be overridden per environment without
# editing a flow file.
SEARCH_QUERY=Software testing

# --- Placeholders for Phase 2 (not read by any Phase 1 code) ---
# Once a real, backend-dependent application is onboarded, environment-
# specific values like these would live here instead of being hardcoded:
# API_BASE_URL=
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
